# ===== DATABASE =====
# Local: postgresql://lft:lft@localhost:5432/labelfoodtrack
# Docker: postgresql://lft:PASSWORD@db:5432/labelfoodtrack
# EasyPanel: postgresql://lft:PASSWORD@labelfoodtrack-db:5432/labelfoodtrack
DATABASE_URL="postgresql://lft:lft@localhost:5432/labelfoodtrack"

# ===== FIREBASE AUTH (client-side) =====
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyD4C84SU11hVqXi0_Xtpt9eldsRYX7Ydo8"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="labelfoodtrack.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="labelfoodtrack"
NEXT_PUBLIC_QR_BASE_URL="https://qr.labelfoodtrack.com"

# ===== FIREBASE ADMIN SDK (server-side) =====
# Encode the service account JSON as base64:
#   Linux/Mac: cat serviceAccountKey.json | base64 -w 0
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccountKey.json"))
FIREBASE_SERVICE_ACCOUNT=""

# Optional one-time bootstrap. Only this verified Firebase email may create the
# very first database administrator. Leave empty after initialization.
BOOTSTRAP_ADMIN_EMAIL=""

# Emergency migration switch only. Keep false during normal operation.
ALLOW_FIREBASE_UID_RELINK="false"

# ===== OPENAI =====
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ===== CHATBOT SERVER INTEGRATION =====
# Server-only master secret (32+ random bytes). Generate a tenant key with:
#   npm run chatbot:key -- CHATBOT_ID
CHATBOT_API_KEY=""

# ===== CLOUDINARY (company logos) =====
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ===== DEMO MODE =====
# Set to "true" for development without real auth/database
# Remove or set "false" for production
NEXT_PUBLIC_DEMO_MODE="false"

# Explicit opt-in required before running the demo database seed.
ALLOW_DATABASE_SEED="false"

# ===== POSTGRES PASSWORD (for docker-compose.prod.yml) =====
POSTGRES_PASSWORD="CHANGE_ME_TO_SECURE_PASSWORD"
